# PaperCollector Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# LLM API Keys
# ============================================

# Kimi (Moonshot) - Used for agentic tasks
# Get from: https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here

# DeepSeek - Used for evaluation and contextual tasks
# Get from: https://platform.deepseek.com/
DEEPSEEK_KEY=your_deepseek_api_key_here

# ModelScope - Fallback provider
# Get from: https://modelscope.cn/
OPENAI_API_KEY=your_modelscope_api_key_here

# Ollama - Local LLM (optional)
# Default: http://localhost:11434
OLLAMA_API_URL=http://localhost:11434

# ============================================
# RAG/Vector Database Settings
# ============================================

# RAG Provider: "milvus" or "pgvector"
RAG_PROVIDER=milvus

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=paper_collector

# Optional: Milvus Lite (for local development)
# MILVUS_LITE_PATH=./milvus.db

# PostgreSQL/PGVector (if using pgvector)
# DATABASE_URL=postgresql://user:password@localhost:5432/paper_collector

# ============================================
# Embedding Model Settings
# ============================================

# Sentence Transformers model for embeddings
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ============================================
# Search & Retrieval Settings
# ============================================

# Top-K results for RAG
MILVUS_TOP_K=10

# Enable Agentic RAG (multi-step retrieval)
ENABLE_AGENTIC_RAG=true

# Chunk strategy: "simple" or "contextual"
CHUNK_STRATEGY=simple

# ============================================
# LangGraph Settings (New)
# ============================================

# Enable LangGraph mode (feature flag)
# Set to "true" to use LangGraph orchestration
# Set to "false" to use original LangChain Agents
USE_LANGGRAPH=true

# LangGraph recursion limit
LANGGRAPH_RECURSION_LIMIT=100
